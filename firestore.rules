rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'akidm083@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidNikoChatMessage(data, userId, messageId) {
      return data.keys().hasAll(['id', 'userId', 'sender', 'text', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'sender', 'text', 'createdAt'])
        && data.id is string && isValidId(data.id) && data.id == messageId
        && data.userId is string && isValidId(data.userId) && data.userId == userId
        && data.sender is string && data.sender.size() <= 10 && data.sender in ['user', 'niko']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidGuestbookEntry(data, entryId) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'message', 'tag', 'createdAt'])
        && data.keys().hasOnly(['id', 'authorId', 'authorName', 'message', 'tag', 'createdAt'])
        && data.id is string && isValidId(data.id) && data.id == entryId
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.tag is string && data.tag.size() <= 20 && data.tag in ['урам', 'cs2', 'санал', 'асуулт']
        && data.createdAt is timestamp;
    }

    function isValidContactMessage(data, messageId) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'senderId', 'senderName', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id) && data.id == messageId
        && data.senderId is string && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1500
        && data.status is string && data.status.size() <= 10 && data.status in ['new', 'read']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Group Rules for Admin Dashboard (O(1) auth check, no DB reads in list)
    match /{path=**}/public/{docId} {
      allow list: if isBootstrappedAdmin() && resource.data.uid is string && resource.data.displayName is string;
    }

    match /{path=**}/private/{docId} {
      allow list: if isBootstrappedAdmin() && resource.data.uid is string && resource.data.email is string;
    }

    match /{path=**}/nikoChats/{messageId} {
      allow list: if isBootstrappedAdmin() && resource.data.userId is string;
    }

    // 5. Collection Rules
    match /users/{userId}/public/{docId} {
      allow get: if isValidId(userId) && docId == 'profile';
      allow create: if isValidId(userId) && docId == 'profile'
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && docId == 'profile'
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && docId == 'profile' && (isOwner(userId) || isAdmin());
    }

    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && docId == 'info'
        && isOwner(userId)
        && isValidPrivateInfo(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin());
    }

    match /users/{userId}/nikoChats/{messageId} {
      allow get: if isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(messageId)
        && isOwner(userId)
        && isValidNikoChatMessage(incoming(), userId, messageId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
    }

    match /guestbook/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.message is string;
      allow create: if isValidId(entryId)
        && isVerifiedUser()
        && isValidGuestbookEntry(incoming(), entryId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(entryId)
        && isVerifiedUser()
        && isValidGuestbookEntry(incoming(), entryId)
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'tag']);
      allow delete: if isValidId(entryId) && (isAdmin() || (isVerifiedUser() && existing().authorId == request.auth.uid));
    }

    match /contactMessages/{messageId} {
      allow get: if isValidId(messageId) && (isAdmin() || (isVerifiedUser() && existing().senderId == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && resource.data.senderId == request.auth.uid);
      allow create: if isValidId(messageId)
        && isVerifiedUser()
        && isValidContactMessage(incoming(), messageId)
        && incoming().senderId == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(messageId)
        && isAdmin()
        && isValidContactMessage(incoming(), messageId)
        && existing().status != 'read'
        && incoming().id == existing().id
        && incoming().senderId == existing().senderId
        && incoming().senderName == existing().senderName
        && incoming().subject == existing().subject
        && incoming().message == existing().message
        && incoming().createdAt == existing().createdAt
        && incoming().status == 'read'
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(messageId) && (isAdmin() || (isVerifiedUser() && existing().senderId == request.auth.uid));
    }
  }
}
