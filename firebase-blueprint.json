{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public display info for a signed-in user without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional profile avatar URL."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": ["uid", "displayName", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII isolated from public reads.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "User verified email address."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account record creation."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "NikoChatMessage": {
      "title": "NikoChatMessage",
      "description": "Persisted message in a user's conversation with Niko CS2 Assistant.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Message ID matching document ID."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "sender": {
          "type": "string",
          "enum": ["user", "niko"],
          "maxLength": 10,
          "description": "Message author role."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Message text content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        }
      },
      "required": ["id", "userId", "sender", "text", "createdAt"]
    },
    "GuestbookEntry": {
      "title": "GuestbookEntry",
      "description": "Public non-PII greeting or note left by a signed-in visitor.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Entry ID matching document ID."
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Author Firebase Auth UID."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Author display name."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Public message text."
        },
        "tag": {
          "type": "string",
          "enum": ["урам", "cs2", "санал", "асуулт"],
          "maxLength": 20,
          "description": "Topic category."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when posted."
        }
      },
      "required": ["id", "authorId", "authorName", "message", "tag", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Direct private message sent to portfolio owner Chingis.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Message ID matching document ID."
        },
        "senderId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Sender Firebase Auth UID."
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Sender name."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Message subject."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "description": "Private message content."
        },
        "status": {
          "type": "string",
          "enum": ["new", "read"],
          "maxLength": 10,
          "description": "Read status managed by admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when sent."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": ["id", "senderId", "senderName", "subject", "message", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/public/{docId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public display profile for a user (docId = profile)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII record isolated to owner and admin (docId = info)."
    },
    "/users/{userId}/nikoChats/{messageId}": {
      "schema": { "$ref": "#/entities/NikoChatMessage" },
      "description": "Persisted Niko CS2 Assistant chat history per user."
    },
    "/guestbook/{entryId}": {
      "schema": { "$ref": "#/entities/GuestbookEntry" },
      "description": "Public non-PII portfolio guestbook entries."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Private direct messages from visitors to portfolio owner."
    }
  }
}
